# Copy to .env and fill in (or set these in Vercel Project Settings -> Environment Variables).

# Urgency SLA, in business hours
URGENT_SLA_BUSINESS_HOURS=2

# Any OpenAI-compatible endpoint (OpenRouter, Groq, Cerebras, Google AI Studio, Ollama, ...)
# e.g. https://api.groq.com/openai/v1  or  https://openrouter.ai/api/v1  or  http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
